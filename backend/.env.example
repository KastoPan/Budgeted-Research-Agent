# Never commit real API keys.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=
# Structured extraction defaults to non-thinking mode for predictable JSON output.
MOONSHOT_THINKING_ENABLED=false
# Optional override. K2.6 currently requires 0.6 when thinking is disabled and
# 1.0 when thinking is enabled; leave unset to select the matching value automatically.
MOONSHOT_TEMPERATURE=
# LLM generation can take much longer than search and page downloads.
MOONSHOT_TIMEOUT_SECONDS=300
# Optional: provide USD-denominated rates for cost accounting.
MOONSHOT_INPUT_COST_PER_MILLION_USD=
MOONSHOT_OUTPUT_COST_PER_MILLION_USD=

TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

REQUEST_TIMEOUT_SECONDS=20
# Retry only transient network/429/5xx failures and Planner schema failures.
# Keep this small because a successful retry can make another billable LLM request.
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_DELAY_SECONDS=0.5

# Embedded API persistence. Relative paths are resolved from backend/.
BRA_DATABASE_PATH=data/budgeted-research.db
BRA_RUNS_PATH=runs
# Comma-separated frontend origins allowed to call the API.
BRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
